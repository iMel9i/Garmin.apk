<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Настройки OpenStreetMap API"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Здесь вы можете настроить API endpoints для получения данных из OpenStreetMap (ограничения скорости, камеры и т.д.)"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TomTom API key (для speed data)"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/editTomTomApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Введите TomTom API key"
        android:inputType="text"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSaveTomTomApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сохранить TomTom API key"
        android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerOsmApis"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
